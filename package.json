{
  "name": "faisal-albalwy-academic-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": ">=11.17.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "prebuild": "npm run sync:orcid",
    "sync:orcid": "node scripts/sync-orcid-publications.mjs --optional",
    "sync:orcid:required": "node scripts/sync-orcid-publications.mjs",
    "format": "prettier --check . --ignore-unknown",
    "format:write": "prettier --write . --ignore-unknown",
    "lint": "node scripts/lint-static.mjs",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "validate:content": "node content/schemas/validate.mjs",
    "validate:ajv": "node scripts/validate-ajv.mjs",
    "tokens:generate": "node scripts/generate-token-bindings.mjs",
    "og:generate": "node scripts/generate-og-card.mjs",
    "og:check": "node scripts/check-og-card.mjs",
    "stage:public": "node scripts/stage-public.mjs",
    "stage:robots": "node scripts/stage-release-robots.mjs",
    "scan:public": "node scripts/scan-public.mjs --input .build/public --staging",
    "release:adapter": "node scripts/generate-release-adapter.mjs",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "release:boundary": "node scripts/check-release-boundary.mjs",
    "build": "npm run validate:content && npm run validate:ajv && npm run tokens:generate && npm run og:generate && npm run stage:public && npm run stage:robots && npm run scan:public && astro build && node scripts/generate-sitemap.mjs && npm run scan:dist && npm run budget && npm run release:adapter && npm run release:manifest && npm run release:boundary",
    "scan:dist": "node scripts/scan-public.mjs --input dist",
    "budget": "node scripts/check-budget.mjs",
    "scope:safety": "node scripts/check-scope-safety.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "licenses": "node scripts/check-dependencies.mjs",
    "analytics:check": "node scripts/check-no-analytics.mjs",
    "contact:check": "node scripts/check-contact-privacy.mjs",
    "verify": "npm run scope:safety && npm run format && npm run lint && npm run check && npm run typecheck && npm run test && npm run audit:dependencies && npm run licenses && npm run build && npm run og:check && npm run analytics:check && npm run contact:check && npm run reproducible",
    "reproducible": "node scripts/verify-reproducible.mjs",
    "preview-local": "astro preview"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.2.3",
    "axe-core": "4.13.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
