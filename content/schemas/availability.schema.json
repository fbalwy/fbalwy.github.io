{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fbalwy.sa/schemas/v1/availability.schema.json",
  "title": "Route module availability and operational state",
  "type": "object",
  "additionalProperties": false,
  "required": ["state_id", "route_id", "module_id", "availability", "reason_code", "heading", "explanation", "affected_content", "primary_recovery", "secondary_route", "programmatic_status", "http_status", "indexing", "remove_heading_and_fragment"],
  "properties": {
    "state_id": { "$ref": "common.schema.json#/$defs/stableId" },
    "route_id": { "enum": ["R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8", "GLOBAL"] },
    "module_id": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "availability": { "enum": ["available", "partial", "empty", "unavailable", "loading", "error", "no_results"] },
    "reason_code": { "enum": ["approved", "no_approved_records", "source_unavailable", "dataset_unavailable", "email_unavailable", "cv_unavailable", "external_link_failure", "query_no_match", "loading", "application_error", "not_found"] },
    "heading": { "type": "string", "minLength": 1 },
    "explanation": { "type": "string", "minLength": 3 },
    "affected_content": { "type": ["string", "null"] },
    "primary_recovery": { "type": ["string", "null"] },
    "secondary_route": { "type": ["string", "null"], "pattern": "^/(?:research|publications|teaching|leadership-service|about|contact)?$" },
    "programmatic_status": { "enum": ["none", "status", "alert"] },
    "http_status": { "enum": [200, 404, 500, 503] },
    "indexing": { "enum": ["index", "noindex_follow", "noindex_nofollow", "not_applicable"] },
    "remove_heading_and_fragment": { "type": "boolean" }
  },
  "allOf": [
    { "if": { "properties": { "availability": { "const": "available" } }, "required": ["availability"] }, "then": { "properties": { "reason_code": { "const": "approved" }, "remove_heading_and_fragment": { "const": false } } } },
    { "if": { "properties": { "availability": { "const": "empty" } }, "required": ["availability"] }, "then": { "properties": { "remove_heading_and_fragment": { "const": true } } } },
    { "if": { "properties": { "availability": { "enum": ["unavailable", "error", "no_results"] } }, "required": ["availability"] }, "then": { "properties": { "primary_recovery": { "type": "string", "minLength": 3 } } } }
  ]
}
