---
interface Props {
  authors: readonly string[];
}

const { authors } = Astro.props;

function isFaisalAlbalwy(author: string): boolean {
  const normalized = author
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/\./g, "")
    .replace(/\s+/g, " ")
    .trim()
    .toLowerCase();

  return /^(?:f|faisal)(?: a)? albalwy$/.test(normalized);
}

function separator(index: number, total: number): string {
  if (index === 0) return "";
  if (index === total - 1) return total === 2 ? " & " : ", & ";
  return ", ";
}
---

<span class="citation-authors">
  {
    authors.map((author, index) => (
      <>
        {separator(index, authors.length)}
        {isFaisalAlbalwy(author) ? (
          <strong class="citation-authors__self">{author}</strong>
        ) : (
          author
        )}
      </>
    ))
  }
</span>
